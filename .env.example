# YantraOS Environment Configuration

# 1. Supabase (Database & Realtime Pub/Sub)
# (Optional for prototype demo - runs in local physics simulator mode if left blank)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. AI Industrial Copilot
# (Optional - uses offline physics-grounded diagnostic engine if left blank)
# Google Gemini API:
GEMINI_API_KEY=your-gemini-api-key-here
# or OpenAI API:
OPENAI_API_KEY=your-openai-api-key-here

# 3. Edge Gateway Ingestion
NEXT_PUBLIC_EDGE_GATEWAY_URL=http://localhost:3000/api/telemetry
NEXT_PUBLIC_FACILITY_ID=00000000-0000-0000-0000-000000000001
